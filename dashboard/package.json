{
  "name": "rl-trading-bot-dashboard",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Static dashboard for the Bitcoin RL trading bot. Renders the artifacts written by backtest.py.",
  "scripts": {
    "sync": "node scripts/sync-results.mjs",
    "dev": "npm run sync && vite",
    "build": "npm run sync && tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.12.7"
  },
  "devDependencies": {
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "typescript": "^5.5.4",
    "vite": "^5.4.2"
  }
}
